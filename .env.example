# Banco de Dados (SQLite local gerado a partir dos CSVs)
DATABASE_URL="sqlite:///db/emporio_musica.db"

# Provedor e Modelo (google | openai | anthropic | ollama)
LLM_PROVIDER="google"
LLM_MODEL="gemini-3.8-flash"

# Chaves de API (preencha de acordo com o LLM_PROVIDER escolhido)
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Limite de passos de ferramentas por turno
MAX_AGENT_STEPS=6
